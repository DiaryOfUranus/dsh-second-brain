{
  "name": "@xianshu/dsh-second-brain",
  "version": "0.1.6",
  "description": "DeepSeek Harness (DSH) plugin: injects a bounded, timestamped snapshot of your local Second Brain (identity + state fingerprint + pointers) into every new session's prompt. Read-only, zero-write, fail-loud, zero dependencies. 第二大脑载入器：让每个新会话开局自带记忆快照。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/probe-block.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "second-brain",
    "memory",
    "ai-memory",
    "long-term-memory",
    "context-injection",
    "workflow",
    "personal-knowledge-base",
    "knowledge-management",
    "prompt-engineering",
    "local-first",
    "privacy-first",
    "read-only",
    "cordis",
    "ai-agent",
    "llm",
    "nodejs",
    "self-improving"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "天王星日记 / DiaryOfUranus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiaryOfUranus/dsh-second-brain.git"
  },
  "bugs": {
    "url": "https://github.com/DiaryOfUranus/dsh-second-brain/issues"
  },
  "homepage": "https://github.com/DiaryOfUranus/dsh-second-brain#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
